/// SAFEHANDOVER DATABASE SCHEMA
///
/// This Prisma schema defines the relational data model used by the
/// SafeHandover backend.
///
/// PURPOSE:
/// The database stores structured information required to support
/// pre-operative handover, safety actions, shift transfers, auditability,
/// consent acknowledgement and prototype evaluation.
///
/// MAIN DATA AREAS:
/// - User accounts and application roles
/// - Patients and scheduled procedures
/// - Handover records
/// - Safety actions
/// - Subsequent/follow-up events
/// - Shift information
/// - Audit logs
/// - Consent acknowledgements
/// - Notifications
/// - Validation feedback
/// - Synthetic experiment results
///
/// DESIGN PRINCIPLE:
/// Safety-critical workflow information is represented using structured
/// fields rather than relying only on free-text descriptions. This makes
/// conditions such as unresolved actions, missing owners and overdue
/// deadlines easier to detect consistently.
///
/// ROLE-BASED ACCESS:
/// User roles are represented using an enum and are used by the backend
/// authorization layer to determine which operations each user can perform.
///
/// SAFETY ACTION LIFECYCLE:
/// SafetyAction records contain structured status/risk information and
/// relationships to users, handovers and follow-up events. This supports
/// tracking an action from creation through acknowledgement, resolution
/// or escalation.
///
/// AUDITABILITY:
/// AuditLog records provide a history of important system changes and
/// support traceability during project review and testing.
///
/// PRIVACY:
/// The project uses synthetic/demo information and is not intended to
/// store real patient information. The schema is designed for the
/// academic prototype and is not a clinically validated production
/// healthcare database.
///
/// Prisma is used to generate the database client and manage the
/// relationship between the Express backend and PostgreSQL.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  SURGEON
  NURSE
  ANAESTHESIA
  COORDINATOR
  VIEWER
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
  OVERDUE
  ESCALATED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role
  department String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions SafetyAction[] @relation("Owner")
  createdActions SafetyAction[] @relation("Creator")
  handovers Handover[] @relation("HandoverCreator")
  acknowledgements Handover[] @relation("HandoverAcknowledger")
  audits AuditLog[]
  events SubsequentEvent[]
  consent ConsentAcknowledgement[]
}
model Patient {
  id String @id @default(cuid())
  syntheticPatientId String @unique
  displayName String
  procedure String
  scheduledDate DateTime
  status String @default("SCHEDULED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  handovers Handover[]
  actions SafetyAction[]
}
model Handover {
  id String @id @default(cuid())
  patientId String
  fromShift String
  toShift String
  createdBy String
  handoverDate DateTime @default(now())
  summary String
  status String @default("DRAFT")
  acknowledgedAt DateTime?
  acknowledgedBy String?
  outgoingAcknowledgedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields: [patientId], references: [id])
  creator User @relation("HandoverCreator", fields: [createdBy], references: [id])
  acknowledger User? @relation("HandoverAcknowledger", fields: [acknowledgedBy], references: [id])
  actions SafetyAction[]
}
model SafetyAction {
  id String @id @default(cuid())
  handoverId String
  patientId String
  title String
  description String
  riskLevel RiskLevel
  category String
  status ActionStatus @default(OPEN)
  ownerId String?
  deadline DateTime?
  createdBy String
  resolvedAt DateTime?
  resolutionNote String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  handover Handover @relation(fields: [handoverId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  owner User? @relation("Owner", fields: [ownerId], references: [id])
  creator User @relation("Creator", fields: [createdBy], references: [id])
  events SubsequentEvent[]
  @@index([status, deadline])
}
model SubsequentEvent {
  id String @id @default(cuid())
  safetyActionId String
  eventType String
  description String
  createdBy String
  eventTime DateTime @default(now())
  createdAt DateTime @default(now())
  action SafetyAction @relation(fields: [safetyActionId], references: [id])
  user User @relation(fields: [createdBy], references: [id])
}
model Shift {
  id String @id @default(cuid())
  name String
  startTime String
  endTime String
  createdBy String
}
model AuditLog {
  id String @id @default(cuid())
  userId String
  entityType String
  entityId String
  action String
  previousValue Json?
  newValue Json?
  timestamp DateTime @default(now())
  ipAddress String?
  user User @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
}
model ConsentAcknowledgement {
  id String @id @default(cuid())
  userId String
  acknowledgementType String
  acknowledged Boolean
  timestamp DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}
model Notification {
  id String @id @default(cuid())
  userId String?
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model ValidationFeedback {
  id String @id @default(cuid())
  role String
  taskTested String
  rating Int
  comment String
  observedIssue String?
  createdAt DateTime @default(now())
}
model ExperimentResult {
  id String @id
  metric String
  method String
  value Float
  sampleSize Int
  generatedAt DateTime @default(now())
}
